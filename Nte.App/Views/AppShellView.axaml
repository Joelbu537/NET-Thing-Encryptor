<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nte.App.ViewModels"
             x:Class="Nte.App.Views.AppShellView"
             x:DataType="vm:AppShellViewModel">
  <Grid RowDefinitions="*,Auto">
    <ContentControl Grid.Row="0" Content="{Binding CurrentPage}" />

    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#50708090"
            Background="{DynamicResource AppSurfaceBrush}" Padding="10,5"
            IsVisible="{OnFormFactor Desktop=True, Mobile=False}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <TextBlock Text="{Binding VersionText}" FontFamily="Consolas" Opacity="0.75"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding FolderStatisticsText}"
                   FontFamily="Consolas" Opacity="0.75" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
