<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nte.App.ViewModels"
             x:Class="Nte.App.Views.VaultDocumentView"
             x:DataType="vm:VaultDocumentViewModel"
             Focusable="True"
             Loaded="VaultDocumentView_Loaded">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="10">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Classes="page-title" Text="{Binding DisplayName}" TextWrapping="Wrap" />
        <TextBlock Text="Geschützte Inhaltsansicht" Opacity="0.65" />
      </StackPanel>
      <Button Grid.Column="1" Content="Zurück" Command="{Binding CloseCommand}" />
    </Grid>

    <Grid Grid.Row="1">
      <Grid IsVisible="{Binding IsText}" RowDefinitions="Auto,*" RowSpacing="8">
        <WrapPanel>
          <Button Content="Bearbeiten / Schreibschutz" Command="{Binding ToggleEditingCommand}" Margin="0,0,8,6" />
          <Button Content="Speichern" Classes="primary" Command="{Binding SaveCommand}" Margin="0,0,8,6" />
          <Button Content="Rückgängig" Click="Undo_Click" Margin="0,0,8,6" />
          <Button Content="Wiederholen" Click="Redo_Click" Margin="0,0,12,6" />
          <TextBox Classes="single-line" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Im Text suchen"
                   Width="220" Margin="0,0,8,6" />
          <TextBlock Text="{Binding SearchResultText}" VerticalAlignment="Center" Margin="0,0,8,6" />
        </WrapPanel>
        <TextBox x:Name="TextEditor" Grid.Row="1" Text="{Binding Text, Mode=TwoWay}"
                 IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono,Consolas,monospace"
                 KeyDown="TextEditor_KeyDown" />
      </Grid>

      <Grid IsVisible="{Binding IsImageDocument}" RowDefinitions="Auto,*" RowSpacing="8">
        <WrapPanel IsVisible="{Binding IsImageSeries}">
          <TextBlock Text="{Binding ImagePositionText}" VerticalAlignment="Center" Margin="0,0,12,6" />
          <Button Content="Reihenfolge mischen" Command="{Binding RandomiseImagesCommand}" Margin="0,0,8,6" />
          <Button Content="{Binding AutoplayButtonText}" Command="{Binding ToggleAutoplayCommand}" Margin="0,0,8,6" />
        </WrapPanel>
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#40607080" CornerRadius="8"
                ClipToBounds="True">
          <Grid>
            <Image Source="{Binding Image}" Stretch="Uniform"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsImageSeries}">
              <Border Grid.Column="0" Background="Transparent" Tapped="PreviousImageArea_Tapped" />
              <Border Grid.Column="1" Background="Transparent" Tapped="NextImageArea_Tapped" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Grid IsVisible="{Binding IsVideo}" RowDefinitions="*,Auto" RowSpacing="10">
        <Border BorderThickness="1" BorderBrush="#40607080" CornerRadius="8"
                Background="Black" ClipToBounds="True" MinHeight="120">
          <Grid>
            <ContentControl Content="{Binding VideoSurface}"
                            IsVisible="{Binding HasVideoPlayback}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
            <TextBlock Text="Der Videoplayer ist auf dieser Plattform nicht verfügbar."
                       IsVisible="{Binding ShowVideoPlaceholder}"
                       Foreground="White" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="24" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
          <Button Grid.Column="0" Classes="media-icon"
                  Content="{Binding VideoPlayPauseSymbol}"
                  Command="{Binding ToggleVideoPlaybackCommand}"
                  ToolTip.Tip="{Binding VideoPlayPauseToolTip}" />
          <Button Grid.Column="1" Classes="media-icon" Content="−10"
                  Command="{Binding SeekVideoBackwardCommand}"
                  ToolTip.Tip="10 Sekunden zurück (Pfeil links oder J)" />
          <Button Grid.Column="2" Classes="media-icon" Content="+10"
                  Command="{Binding SeekVideoForwardCommand}"
                  ToolTip.Tip="10 Sekunden vor (Pfeil rechts oder L)" />
          <Slider x:Name="VideoTimeline" Grid.Column="3"
                  Minimum="0" Maximum="{Binding VideoTimelineMaximum}"
                  Value="{Binding VideoPositionMilliseconds, Mode=TwoWay}"
                  IsEnabled="{Binding CanSeekVideo}"
                  VerticalAlignment="Center"
                  PointerPressed="VideoTimeline_PointerPressed"
                  PointerReleased="VideoTimeline_PointerReleased"
                  PointerCaptureLost="VideoTimeline_PointerCaptureLost"
                  ToolTip.Tip="Klicken oder ziehen, um die Wiedergabeposition zu ändern" />
          <TextBlock Grid.Column="4" Text="{Binding VideoTimeText}"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     VerticalAlignment="Center" />
        </Grid>
      </Grid>

      <Border IsVisible="{Binding IsGeneric}" Padding="24" BorderThickness="1"
              BorderBrush="#40607080" CornerRadius="8">
        <TextBlock Text="{Binding GenericMessage}" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" />
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Spacing="8">
      <WrapPanel IsVisible="{Binding IsText}">
        <TextBlock Text="{Binding EncodingText}" Opacity="0.65" Margin="0,0,16,0" />
        <TextBlock Text="{Binding CharacterCountText}" Opacity="0.65" />
      </WrapPanel>
      <TextBlock Classes="error" Text="{Binding ErrorMessage}" />
      <Border Padding="10" CornerRadius="6" Background="#20D13438"
              IsVisible="{Binding ShowDiscardConfirmation}">
        <StackPanel Spacing="8">
          <TextBlock Text="Ungespeicherte Textänderungen verwerfen?" FontWeight="SemiBold" />
          <WrapPanel>
            <Button Content="Weiter bearbeiten" Command="{Binding CancelCloseCommand}" Margin="0,0,8,0" />
            <Button Content="Änderungen verwerfen" Command="{Binding DiscardAndCloseCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
