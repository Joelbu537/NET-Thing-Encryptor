<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nte.App.ViewModels"
             x:Class="Nte.App.Views.VaultView"
             x:DataType="vm:VaultViewModel">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
    <StackPanel Grid.Row="0" Spacing="8">
      <StackPanel>
        <TextBlock Classes="page-title" Text="Tresor" />
        <TextBlock Text="{Binding Breadcrumb}" FontSize="15" Opacity="0.75"
                   TextWrapping="Wrap" />
      </StackPanel>
      <WrapPanel>
        <Button Content="Tresor exportieren …" Command="{Binding ExportVaultCommand}"
                Margin="0,0,8,6" />
        <Button Content="Sperren" Command="{Binding LockCommand}" Margin="0,0,8,6" />
      </WrapPanel>
    </StackPanel>

    <WrapPanel Grid.Row="1">
      <Button Content="Zurück" Command="{Binding BackCommand}" Margin="0,0,8,6" />
      <Button Content="Ordner öffnen" Command="{Binding OpenSelectedCommand}" Margin="0,0,8,6" />
      <Button Content="Dokumente importieren …" Command="{Binding ImportDocumentsCommand}"
              Margin="0,0,8,6" />
      <Button Content="Auswahl exportieren …" Command="{Binding ExportSelectedCommand}"
              Margin="0,0,8,6" />
      <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Margin="0,0,8,6" />
    </WrapPanel>

    <Grid Grid.Row="2">
      <Border BorderThickness="1" BorderBrush="#40607080" CornerRadius="8">
        <ListBox ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:VaultItemViewModel">
              <Grid ColumnDefinitions="36,*" Margin="6">
                <TextBlock Text="{Binding Symbol}" FontSize="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <WrapPanel>
                    <TextBlock Text="{Binding KindText}" FontSize="12" Opacity="0.65"
                               Margin="0,0,12,0" />
                    <TextBlock Text="{Binding CreatedAt}" FontSize="12" Opacity="0.65"
                               Margin="0,0,12,0" />
                    <TextBlock Text="{Binding SizeText}" FontSize="12" Opacity="0.65" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding !HasItems}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextWrapping="Wrap" Opacity="0.65" Margin="16" />
    </Grid>

    <Border Grid.Row="3" Padding="10" CornerRadius="8" Background="#101769AA">
      <StackPanel Spacing="8">
        <TextBlock Text="Neuer Ordner" FontWeight="SemiBold" />
        <WrapPanel>
          <TextBox Text="{Binding NewFolderName, Mode=TwoWay}"
                   PlaceholderText="Ordnername" Width="240" Margin="0,0,8,6" />
          <Button Content="Anlegen" Command="{Binding CreateFolderCommand}" Margin="0,0,8,6" />
        </WrapPanel>
        <TextBlock Text="Dateien können aus Formatgründen nur innerhalb eines Ordners liegen."
                   TextWrapping="Wrap" Opacity="0.65" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="4" Classes="error" Text="{Binding ErrorMessage}" />
  </Grid>
</UserControl>
