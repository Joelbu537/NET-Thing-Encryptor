<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nte.App.ViewModels"
             x:Class="Nte.App.Views.VaultView"
             x:DataType="vm:VaultViewModel">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="14">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Classes="page-title" Text="Tresor" />
        <TextBlock Text="{Binding Breadcrumb}" FontSize="15" Opacity="0.75" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Tresor exportieren …" Command="{Binding ExportVaultCommand}" />
        <Button Content="Sperren" Command="{Binding LockCommand}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Button Content="Zurück" Command="{Binding BackCommand}" />
      <Button Content="Ordner öffnen" Command="{Binding OpenSelectedCommand}" />
      <Button Content="Dokumente importieren …" Command="{Binding ImportDocumentsCommand}" />
      <Button Content="Auswahl exportieren …" Command="{Binding ExportSelectedCommand}" />
      <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Border BorderThickness="1" BorderBrush="#40607080" CornerRadius="8">
        <ListBox ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:VaultItemViewModel">
              <Grid ColumnDefinitions="42,*,120,110" Margin="8,6">
                <TextBlock Text="{Binding Symbol}" FontSize="21" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding KindText}" FontSize="12" Opacity="0.65" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding CreatedAt}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding !HasItems}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextWrapping="Wrap" Opacity="0.65" Margin="24" />
    </Grid>

    <Border Grid.Row="3" Padding="12" CornerRadius="8" Background="#101769AA">
      <Grid ColumnDefinitions="Auto,260,Auto,*" ColumnSpacing="8">
        <TextBlock Text="Neuer Ordner" VerticalAlignment="Center" FontWeight="SemiBold" />
        <TextBox Grid.Column="1" Text="{Binding NewFolderName, Mode=TwoWay}"
                 PlaceholderText="Ordnername" />
        <Button Grid.Column="2" Content="Anlegen" Command="{Binding CreateFolderCommand}" />
        <TextBlock Grid.Column="3" Text="Dateien können aus Formatgründen nur innerhalb eines Ordners liegen."
                   VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.65" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="4" Classes="error" Text="{Binding ErrorMessage}" />
  </Grid>
</UserControl>
