<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nte.App.ViewModels"
             x:Class="Nte.App.Views.VaultView"
             x:DataType="vm:VaultViewModel">
  <Grid>
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="10"
          IsVisible="{Binding ShowVaultContent}">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="page-title" Text="Tresor" />
          <TextBlock Text="{Binding Breadcrumb}" FontSize="15" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
          <Button Content="Einstellungen" Command="{Binding ToggleSettingsCommand}" Margin="0,0,8,6" />
          <Button Content="Tresor exportieren …" Command="{Binding ExportVaultCommand}" Margin="0,0,8,6" />
          <Button Content="Sperren" Command="{Binding LockCommand}" Margin="0,0,0,6" />
        </WrapPanel>
      </Grid>

      <Border Grid.Row="1" Padding="10" CornerRadius="8" Background="#101769AA">
        <StackPanel Spacing="7">
          <WrapPanel>
            <TextBox Text="{Binding SearchQuery, Mode=TwoWay}" PlaceholderText="Name, Erweiterung oder Typ"
                     Width="260" Margin="0,0,8,6" />
            <CheckBox Content="Gesamten Tresor durchsuchen" IsChecked="{Binding SearchGlobally, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,12,6" />
            <Button Content="Suchen" Command="{Binding SearchCommand}" Margin="0,0,8,6" />
            <Button Content="Zurücksetzen" Command="{Binding ClearSearchCommand}" Margin="0,0,8,6" />
          </WrapPanel>
          <WrapPanel IsVisible="{Binding ShowAdvancedSearch}">
            <TextBox Text="{Binding SearchExtension, Mode=TwoWay}" PlaceholderText="Erweiterung"
                     Width="120" Margin="0,0,8,6" />
            <ComboBox ItemsSource="{Binding SearchTypes}" SelectedItem="{Binding SelectedSearchType, Mode=TwoWay}"
                      Width="150" Margin="0,0,8,6" />
            <TextBox Text="{Binding MinimumSizeText, Mode=TwoWay}" PlaceholderText="Min. Bytes"
                     Width="120" Margin="0,0,8,6" />
            <TextBox Text="{Binding MaximumSizeText, Mode=TwoWay}" PlaceholderText="Max. Bytes"
                     Width="120" Margin="0,0,8,6" />
            <DatePicker SelectedDate="{Binding CreatedFrom, Mode=TwoWay}" Width="150" Margin="0,0,8,6" />
            <DatePicker SelectedDate="{Binding CreatedTo, Mode=TwoWay}" Width="150" Margin="0,0,8,6" />
          </WrapPanel>
          <TextBlock Text="{Binding ResultSummary}" Opacity="0.7" />
        </StackPanel>
      </Border>

      <WrapPanel Grid.Row="2">
        <Button Content="Zurück" Command="{Binding BackCommand}" Margin="0,0,8,6" />
        <Button Content="Öffnen / Anzeigen" Command="{Binding OpenSelectedCommand}" Margin="0,0,8,6" />
        <Button Content="Dokumente importieren …" Command="{Binding ImportDocumentsCommand}" Margin="0,0,8,6" />
        <Button Content="Auswahl exportieren …" Command="{Binding ExportSelectedCommand}" Margin="0,0,8,6" />
        <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Margin="0,0,8,6" />
      </WrapPanel>

      <Grid Grid.Row="3">
        <Border BorderThickness="1" BorderBrush="#40607080" CornerRadius="8">
          <ListBox ItemsSource="{Binding Items}" SelectionMode="Multiple,Toggle"
                   SelectionChanged="Items_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:VaultItemViewModel">
                <Grid ColumnDefinitions="36,*" Margin="6">
                  <TextBlock Text="{Binding Symbol}" FontSize="20" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <WrapPanel>
                      <TextBlock Text="{Binding KindText}" FontSize="12" Opacity="0.65" Margin="0,0,12,0" />
                      <TextBlock Text="{Binding CreatedAt}" FontSize="12" Opacity="0.65" Margin="0,0,12,0" />
                      <TextBlock Text="{Binding SizeText}" FontSize="12" Opacity="0.65" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Location}" IsVisible="{Binding HasLocation}"
                               FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding !HasItems}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" Opacity="0.65" Margin="16" />
      </Grid>

      <Border Grid.Row="4" Padding="10" CornerRadius="8" BorderThickness="1" BorderBrush="#40607080">
        <StackPanel Spacing="8">
          <WrapPanel>
            <TextBlock Text="Auswahl" FontWeight="SemiBold" Margin="0,0,12,0" />
            <TextBlock Text="{Binding SelectionCountText}" Opacity="0.65" />
          </WrapPanel>
          <WrapPanel>
            <TextBox Text="{Binding RenameName, Mode=TwoWay}" PlaceholderText="Neuer Name"
                     Width="220" Margin="0,0,8,6" />
            <Button Content="Umbenennen" Command="{Binding RenameCommand}" Margin="0,0,12,6" />
            <ComboBox ItemsSource="{Binding FolderTargets}" SelectedItem="{Binding SelectedMoveTarget, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Path}" PlaceholderText="Zielordner"
                      Width="280" Margin="0,0,8,6" />
            <Button Content="Verschieben" Command="{Binding MoveCommand}" Margin="0,0,12,6" />
            <Button Content="Löschen …" Command="{Binding RequestDeleteCommand}" Margin="0,0,8,6" />
          </WrapPanel>
          <Border Padding="10" CornerRadius="6" Background="#20D13438"
                  IsVisible="{Binding ShowDeleteConfirmation}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding DeleteConfirmationText}" TextWrapping="Wrap" FontWeight="SemiBold" />
              <WrapPanel>
                <Button Content="Endgültig löschen" Classes="danger" Command="{Binding ConfirmDeleteCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Abbrechen" Command="{Binding CancelDeleteCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Row="5" Padding="10" CornerRadius="8" Background="#101769AA">
        <StackPanel Spacing="8">
          <TextBlock Text="Neuer Ordner" FontWeight="SemiBold" />
          <WrapPanel>
            <TextBox Text="{Binding NewFolderName, Mode=TwoWay}" PlaceholderText="Ordnername"
                     Width="240" Margin="0,0,8,6" />
            <Button Content="Anlegen" Command="{Binding CreateFolderCommand}" Margin="0,0,8,6" />
          </WrapPanel>
          <TextBlock Text="Dateien können aus Formatgründen nur innerhalb eines Ordners liegen."
                     TextWrapping="Wrap" Opacity="0.65" />
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="6" Classes="error" Text="{Binding ErrorMessage}" />

      <Border Grid.Row="1" Grid.RowSpan="5" Padding="16" CornerRadius="8"
              Background="{DynamicResource SolidBackgroundFillColorBase}"
              BorderBrush="#40607080" BorderThickness="1"
              IsVisible="{Binding ShowSettings}" ZIndex="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Classes="page-title" Text="Einstellungen" />
            <CheckBox Content="Dunkles Erscheinungsbild" IsChecked="{Binding DarkMode, Mode=TwoWay}" />
            <TextBlock Text="Automatische Sperre in Minuten (0 deaktiviert)" />
            <TextBox Text="{Binding AutoLockMinutes, Mode=TwoWay}" Width="140" HorizontalAlignment="Left" />
            <TextBlock Text="Bildpuffer vor / nach dem aktuellen Bild" />
            <WrapPanel>
              <TextBox Text="{Binding PreviousImageBufferCount, Mode=TwoWay}" Width="100" Margin="0,0,8,0" />
              <TextBox Text="{Binding NextImageBufferCount, Mode=TwoWay}" Width="100" />
            </WrapPanel>
            <CheckBox Content="Ausgewähltes Bild bei Zufallsreihenfolge einbeziehen"
                      IsChecked="{Binding IncludeSelectedImageWhenRandomising, Mode=TwoWay}" />
            <TextBlock Text="Bild-Autoplay-Intervall in Sekunden" />
            <TextBox Text="{Binding ImageAutoplayIntervalSeconds, Mode=TwoWay}"
                     Width="140" HorizontalAlignment="Left" />
            <CheckBox Content="Bild-Autoplay wiederholen" IsChecked="{Binding LoopImageAutoplay, Mode=TwoWay}" />
            <WrapPanel>
              <Button Content="Speichern und anwenden" Classes="primary"
                      Command="{Binding SavePreferencesCommand}" Margin="0,0,8,0" />
              <Button Content="Schließen" Command="{Binding ToggleSettingsCommand}" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <ContentControl Content="{Binding ActiveDocument}" IsVisible="{Binding HasActiveDocument}" />
  </Grid>
</UserControl>
