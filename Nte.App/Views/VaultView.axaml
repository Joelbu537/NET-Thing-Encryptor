<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nte.App.ViewModels"
             xmlns:views="using:Nte.App.Views"
             xmlns:converters="using:Nte.App.Converters"
             x:Class="Nte.App.Views.VaultView"
             x:Name="ViewRoot"
             x:DataType="vm:VaultViewModel">
  <UserControl.Resources>
    <converters:FileTypeIconConverter x:Key="FileTypeIconConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.toolbar">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>
    <Style Selector="Button.row-menu">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="22" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8"
          IsVisible="{Binding ShowVaultContent}">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7"
            IsVisible="{OnFormFactor Desktop=True, Mobile=False}">
        <StackPanel Orientation="Horizontal">
          <Button Classes="toolbar" Command="{Binding BackCommand}"
                  ToolTip.Tip="Zurück" AutomationProperties.Name="Zurück">
            <Image Source="/Assets/Legacy/imageres_return.ico" Width="28" Height="28" />
          </Button>
          <Button Classes="toolbar" Command="{Binding GoRootCommand}"
                  ToolTip.Tip="Zum Stammverzeichnis" AutomationProperties.Name="Zum Stammverzeichnis">
            <Image Source="/Assets/Legacy/imageres_explorer.ico" Width="28" Height="28" />
          </Button>
          <Button Classes="toolbar" Command="{Binding ImportDocumentsCommand}"
                  ToolTip.Tip="Neue Datei importieren" AutomationProperties.Name="Neue Datei importieren">
            <Image Source="/Assets/Legacy/imageres_new_file.ico" Width="28" Height="28" />
          </Button>
          <Button Classes="toolbar" Command="{Binding RequestCreateFolderCommand}"
                  ToolTip.Tip="Neuer Ordner" AutomationProperties.Name="Neuer Ordner">
            <Image Source="/Assets/Legacy/imageres_folder_empty.ico" Width="28" Height="28" />
          </Button>
          <Button Classes="toolbar" Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Aktualisieren" AutomationProperties.Name="Aktualisieren">
            <PathIcon Width="23" Height="23"
                      Data="M12,4 A8,8 0 1 0 19.4,9 L17.2,9 A6,6 0 1 1 12,6 L12,9 L17,5 L12,1 Z" />
          </Button>
        </StackPanel>

        <Border Grid.Column="1" BorderThickness="1" BorderBrush="#50607080" CornerRadius="5"
                Padding="10,0" Background="{DynamicResource ControlLowBrush}"
                MinHeight="44" VerticalAlignment="Stretch">
          <TextBlock Text="{Binding Breadcrumb}" VerticalAlignment="Center"
                     FontFamily="Consolas" TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"
                     AutomationProperties.Name="Aktueller Pfad" />
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Classes="toolbar" Command="{Binding ToggleSettingsCommand}"
                  ToolTip.Tip="Einstellungen" AutomationProperties.Name="Einstellungen">
            <Image Source="/Assets/Legacy/shell32_gear.ico" Width="28" Height="28" />
          </Button>
          <Button Classes="toolbar" Command="{Binding LockCommand}"
                  ToolTip.Tip="Tresor sperren" AutomationProperties.Name="Tresor sperren" Margin="0">
            <PathIcon Width="22" Height="22"
                      Data="M7,10 L7,7 A5,5 0 0 1 17,7 L17,10 L19,10 L19,22 L5,22 L5,10 Z M9,10 L15,10 L15,7 A3,3 0 0 0 9,7 Z M12,14 A2,2 0 0 0 11,17.73 L11,19 L13,19 L13,17.73 A2,2 0 0 0 12,14 Z" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="0" RowDefinitions="Auto,Auto" RowSpacing="5"
            IsVisible="{OnFormFactor Desktop=False, Mobile=True}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="5">
          <Button Classes="toolbar" Command="{Binding BackCommand}"
                  ToolTip.Tip="Zurück" AutomationProperties.Name="Zurück">
            <Image Source="/Assets/Legacy/imageres_return.ico" Width="28" Height="28" />
          </Button>
          <Button Grid.Column="1" Classes="toolbar" Command="{Binding GoRootCommand}"
                  ToolTip.Tip="Zum Stammverzeichnis" AutomationProperties.Name="Zum Stammverzeichnis">
            <Image Source="/Assets/Legacy/imageres_explorer.ico" Width="28" Height="28" />
          </Button>

          <Border Grid.Column="2" BorderThickness="1" BorderBrush="#50607080" CornerRadius="5"
                  Padding="10,0" Background="{DynamicResource ControlLowBrush}"
                  MinHeight="44" VerticalAlignment="Stretch">
            <TextBlock Text="{Binding Breadcrumb}" VerticalAlignment="Center"
                       FontFamily="Consolas" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="Aktueller Pfad" />
          </Border>

          <Button Grid.Column="3" Classes="toolbar" Command="{Binding ToggleSettingsCommand}"
                  ToolTip.Tip="Einstellungen" AutomationProperties.Name="Einstellungen">
            <Image Source="/Assets/Legacy/shell32_gear.ico" Width="28" Height="28" />
          </Button>
          <Button Grid.Column="4" Classes="toolbar" Command="{Binding LockCommand}"
                  ToolTip.Tip="Tresor sperren" AutomationProperties.Name="Tresor sperren" Margin="0">
            <PathIcon Width="22" Height="22"
                      Data="M7,10 L7,7 A5,5 0 0 1 17,7 L17,10 L19,10 L19,22 L5,22 L5,10 Z M9,10 L15,10 L15,7 A3,3 0 0 0 9,7 Z M12,14 A2,2 0 0 0 11,17.73 L11,19 L13,19 L13,17.73 A2,2 0 0 0 12,14 Z" />
          </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
          <Button Classes="toolbar" Command="{Binding ImportDocumentsCommand}"
                  ToolTip.Tip="Neue Datei importieren" AutomationProperties.Name="Neue Datei importieren">
            <Image Source="/Assets/Legacy/imageres_new_file.ico" Width="28" Height="28" />
          </Button>
          <Button Classes="toolbar" Command="{Binding RequestCreateFolderCommand}"
                  ToolTip.Tip="Neuer Ordner" AutomationProperties.Name="Neuer Ordner">
            <Image Source="/Assets/Legacy/imageres_folder_empty.ico" Width="28" Height="28" />
          </Button>
          <Button Classes="toolbar" Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Aktualisieren" AutomationProperties.Name="Aktualisieren" Margin="0">
            <PathIcon Width="23" Height="23"
                      Data="M12,4 A8,8 0 1 0 19.4,9 L17.2,9 A6,6 0 1 1 12,6 L12,9 L17,5 L12,1 Z" />
          </Button>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Padding="9" CornerRadius="7" Background="#101769AA">
        <StackPanel Spacing="7">
          <WrapPanel>
            <Grid Width="280" Margin="0,0,8,5">
              <TextBox Classes="single-line"
                       Text="{Binding SearchQuery, Mode=TwoWay}"
                       PlaceholderText="Name, Erweiterung oder Typ"
                       Padding="8,0,34,0"
                       KeyDown="SearchTextBox_KeyDown" />
              <Button Command="{Binding ClearSearchCommand}"
                      Width="30" Height="30" Padding="4" Margin="0,2,2,2"
                      HorizontalAlignment="Right" VerticalAlignment="Stretch"
                      Background="Transparent" BorderThickness="0"
                      ToolTip.Tip="Suche zurücksetzen"
                      AutomationProperties.Name="Suche zurücksetzen">
                <TextBlock Text="✕" FontSize="16" VerticalAlignment="Center" />
              </Button>
            </Grid>
            <CheckBox Content="Gesamten Tresor durchsuchen" IsChecked="{Binding SearchGlobally, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,8,5" />
            <Button Command="{Binding SearchCommand}" Width="38" Height="34" Padding="7"
                    Margin="0,0,5,5" ToolTip.Tip="Suchen" AutomationProperties.Name="Suchen">
              <TextBlock Text="🔍" FontSize="18" VerticalAlignment="Center" />
            </Button>
          </WrapPanel>
          <WrapPanel IsVisible="{Binding ShowAdvancedSearch}">
            <TextBox Classes="single-line" Text="{Binding SearchExtension, Mode=TwoWay}" PlaceholderText="Erweiterung"
                     Width="115" Margin="0,0,8,5" />
            <ComboBox ItemsSource="{Binding SearchTypes}" SelectedItem="{Binding SelectedSearchType, Mode=TwoWay}"
                      Width="150" Margin="0,0,8,5" />
            <TextBox Classes="single-line" Text="{Binding MinimumSizeText, Mode=TwoWay}" PlaceholderText="Min. Bytes"
                     Width="115" Margin="0,0,8,5" />
            <TextBox Classes="single-line" Text="{Binding MaximumSizeText, Mode=TwoWay}" PlaceholderText="Max. Bytes"
                     Width="115" Margin="0,0,8,5" />
            <DatePicker SelectedDate="{Binding CreatedFrom, Mode=TwoWay}" Width="150" Margin="0,0,8,5" />
            <DatePicker SelectedDate="{Binding CreatedTo, Mode=TwoWay}" Width="150" Margin="0,0,8,5" />
          </WrapPanel>
          <TextBlock Text="{Binding ResultSummary}" IsVisible="{Binding ShowAdvancedSearch}"
                     Opacity="0.7" />
        </StackPanel>
      </Border>

      <Grid Grid.Row="2" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="8,6" Background="#181769AA"
                IsVisible="{OnFormFactor Desktop=True, Mobile=False}">
          <Grid ColumnDefinitions="40,*,120,100,120">
            <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Typ" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="Größe" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="Erstellt" FontWeight="SemiBold" />
          </Grid>
        </Border>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#50607080" CornerRadius="0,0,7,7">
          <ListBox x:Name="ItemsList" ItemsSource="{Binding Items}" SelectionMode="Multiple"
                   SelectionChanged="Items_SelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="2,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:VaultItemViewModel">
                <Grid Margin="2,0" MinHeight="34" ColumnDefinitions="40,*"
                      Background="Transparent"
                      PointerPressed="Item_PointerPressed" DoubleTapped="Item_DoubleTapped">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Exportieren …" Click="ExportMenuItem_Click" />
                      <MenuItem Header="Umbenennen …" Click="RenameMenuItem_Click" />
                      <MenuItem Header="Verschieben …" Click="MoveMenuItem_Click" />
                      <Separator />
                      <MenuItem Header="Löschen …" Click="DeleteMenuItem_Click" />
                    </ContextMenu>
                  </Grid.ContextMenu>

                  <Image Source="{Binding Type, Converter={StaticResource FileTypeIconConverter}}"
                         Width="32" Height="32" VerticalAlignment="Center"
                         AutomationProperties.Name="{Binding KindText}" />

                  <Grid Grid.Column="1" ColumnDefinitions="*,120,100,120"
                        IsVisible="{OnFormFactor Desktop=True, Mobile=False}">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Location}" IsVisible="{Binding HasLocation}"
                                 FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding KindText}" VerticalAlignment="Center" Opacity="0.75" />
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" Opacity="0.75" />
                    <TextBlock Grid.Column="3" Text="{Binding CreatedAt}" VerticalAlignment="Center" Opacity="0.75" />
                  </Grid>

                  <Grid Grid.Column="1" ColumnDefinitions="*,Auto"
                        IsVisible="{OnFormFactor Desktop=False, Mobile=True}">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <WrapPanel>
                        <TextBlock Text="{Binding KindText}" FontSize="12" Opacity="0.65" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding SizeText}" FontSize="12" Opacity="0.65" />
                      </WrapPanel>
                      <TextBlock Text="{Binding Location}" IsVisible="{Binding HasLocation}"
                                 FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="row-menu" Content="⋮"
                            Click="ItemActionsButton_Click"
                            ToolTip.Tip="Aktionen" AutomationProperties.Name="Aktionen">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="Exportieren …" Click="ExportMenuItem_Click" />
                          <MenuItem Header="Umbenennen …" Click="RenameMenuItem_Click" />
                          <MenuItem Header="Verschieben …" Click="MoveMenuItem_Click" />
                          <MenuItem Header="Löschen …" Click="DeleteMenuItem_Click" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}" IsVisible="{Binding !HasItems}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" Opacity="0.65" Margin="16" />
      </Grid>

      <TextBlock Grid.Row="3" Classes="error" Text="{Binding ErrorMessage}" />
    </Grid>

    <ContentControl Content="{Binding ActiveDocument}" IsVisible="{Binding ShowInlineDocument}" ZIndex="20" />

    <Grid IsVisible="{Binding HasActionDialog}" ZIndex="30">
      <Border Background="{DynamicResource AppScrimBrush}" />
      <Border MaxWidth="480" Margin="16" Padding="22" CornerRadius="10"
              Background="{DynamicResource AppElevatedSurfaceBrush}"
              BorderBrush="#80607080" BorderThickness="1"
              HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <StackPanel IsVisible="{Binding ShowCreateFolderDialog}" Spacing="12">
            <TextBlock Text="Neuer Ordner" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Dateien können aus Formatgründen nur innerhalb eines Ordners liegen."
                       TextWrapping="Wrap" Opacity="0.7" />
            <TextBox Classes="single-line" Text="{Binding NewFolderName, Mode=TwoWay}" PlaceholderText="Ordnername" />
            <WrapPanel HorizontalAlignment="Right">
              <Button Content="Abbrechen" Command="{Binding CancelActionDialogCommand}"
                      Margin="0,0,8,0" />
              <Button Content="Anlegen" Classes="primary" Command="{Binding CreateFolderCommand}" />
            </WrapPanel>
          </StackPanel>

          <StackPanel IsVisible="{Binding ShowRenameDialog}" Spacing="12">
            <TextBlock Text="Umbenennen" FontSize="22" FontWeight="SemiBold" />
            <TextBox Classes="single-line" Text="{Binding RenameName, Mode=TwoWay}" PlaceholderText="Neuer Name" />
            <WrapPanel HorizontalAlignment="Right">
              <Button Content="Abbrechen" Command="{Binding CancelActionDialogCommand}"
                      Margin="0,0,8,0" />
              <Button Content="Umbenennen" Classes="primary" Command="{Binding RenameCommand}" />
            </WrapPanel>
          </StackPanel>

          <StackPanel IsVisible="{Binding ShowMoveDialog}" Spacing="12">
            <TextBlock Text="Auswahl verschieben" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Zielordner auswählen:" />
            <ComboBox ItemsSource="{Binding FolderTargets}"
                      SelectedItem="{Binding SelectedMoveTarget, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Path}"
                      PlaceholderText="Zielordner" />
            <WrapPanel HorizontalAlignment="Right">
              <Button Content="Abbrechen" Command="{Binding CancelActionDialogCommand}"
                      Margin="0,0,8,0" />
              <Button Content="Verschieben" Classes="primary" Command="{Binding MoveCommand}" />
            </WrapPanel>
          </StackPanel>

          <StackPanel IsVisible="{Binding ShowDeleteConfirmation}" Spacing="12">
            <TextBlock Text="Endgültig löschen?" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DeleteConfirmationText}" TextWrapping="Wrap" />
            <WrapPanel HorizontalAlignment="Right">
              <Button Content="Abbrechen" Command="{Binding CancelActionDialogCommand}"
                      Margin="0,0,8,0" />
              <Button Content="Endgültig löschen" Classes="danger" Command="{Binding ConfirmDeleteCommand}" />
            </WrapPanel>
          </StackPanel>

          <TextBlock Classes="error" Text="{Binding ErrorMessage}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid IsVisible="{OnFormFactor Desktop=False, Mobile=True}"
          IsHitTestVisible="{Binding ShowSettings}" ZIndex="40">
      <views:SettingsView IsVisible="{Binding ShowSettings}" />
    </Grid>
  </Grid>
</UserControl>
