<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nte.App.ViewModels"
             x:Class="Nte.App.Views.LoadingView"
             x:DataType="vm:LoadingViewModel">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
    <ProgressBar IsIndeterminate="True" Width="240" />
    <TextBlock Text="{Binding Message}" FontSize="18" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
