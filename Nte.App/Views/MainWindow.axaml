<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nte.App.ViewModels"
        x:Class="Nte.App.Views.MainWindow"
        x:DataType="vm:AppShellViewModel"
        Title="NET Thing Encryptor"
        Width="1024"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="#123A56" Padding="24,16">
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="38" Height="38" CornerRadius="8" Background="#2B88D8">
          <TextBlock Text="N" Foreground="White" FontSize="22" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="NET Thing Encryptor" Foreground="White"
                     FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Plattformübergreifender M3-Client" Foreground="#C7E0F4" />
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />

    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#30708090" Padding="18,10">
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
