<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Nte.App.Views"
        x:Class="Nte.App.Views.MainWindow"
        Title="NET Thing Encryptor"
        Icon="/Assets/AppIcon.png"
        Width="1024"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppSurfaceBrush}">
  <views:WindowFrame x:Name="Frame" Title="NET Thing Encryptor" />
</Window>
