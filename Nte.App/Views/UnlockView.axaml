<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nte.App.ViewModels"
             x:Class="Nte.App.Views.UnlockView"
             x:DataType="vm:UnlockViewModel"
             Loaded="UnlockView_Loaded">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <Border Margin="16" MaxWidth="520" Padding="24" CornerRadius="12" BorderThickness="1"
            BorderBrush="#40607080" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="16">
        <TextBlock Classes="page-title" Text="{Binding Heading}" />
        <TextBlock Text="{Binding InstructionText}"
                   TextWrapping="Wrap" Opacity="0.75" />
        <TextBlock Text="Passwort" FontWeight="SemiBold" />
        <TextBox x:Name="PasswordTextBox"
                 Classes="single-line"
                 Text="{Binding Password, Mode=TwoWay}"
                 PasswordChar="●"
                 PlaceholderText="Passwort"
                 MinHeight="42" />
        <StackPanel Spacing="8" IsVisible="{Binding IsPasswordConfirmationVisible}">
          <TextBlock Text="Passwort bestätigen" FontWeight="SemiBold" />
          <TextBox Classes="single-line"
                   Text="{Binding PasswordConfirmation, Mode=TwoWay}"
                   PasswordChar="●"
                   PlaceholderText="Passwort bestätigen"
                   MinHeight="42" />
        </StackPanel>
        <Button Classes="primary" Content="Entsperren" Command="{Binding UnlockCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                MinHeight="42" IsDefault="True" />
        <TextBlock Classes="error" Text="{Binding ErrorMessage}" />
        <StackPanel x:Name="VaultSourceSelection"
                    Margin="0,8,0,0"
                    Spacing="12"
                    IsVisible="{Binding IsVaultSourceSelectionVisible}">
          <Border x:Name="VaultImportArea"
                  Padding="14" CornerRadius="8" Background="#101769AA">
            <StackPanel Spacing="8">
              <TextBlock Text="Vorhandenen Tresor übernehmen" FontWeight="SemiBold" />
              <TextBlock Text="Importiere ein vorhandenes .ntevault-Archiv von diesem Gerät."
                         TextWrapping="Wrap" Opacity="0.75" />
              <Button Content="Tresorarchiv importieren …"
                      Command="{Binding ImportVaultCommand}"
                      IsEnabled="{Binding CanImportVault}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Border x:Name="RemoteVaultArea"
                  Padding="14"
                  CornerRadius="8"
                  Background="#101769AA"
                  ToolTip.Tip="{Binding RemoteVaultConnectionHint}">
            <StackPanel Spacing="8">
              <TextBlock Text="Remote-Tresor" FontWeight="SemiBold" />
              <TextBlock Text="Verbinde dich künftig mit einem Tresor auf einem anderen Server. Diese Funktion ist noch nicht verfügbar."
                         TextWrapping="Wrap" Opacity="0.75" />
              <Button x:Name="ConnectRemoteVaultButton"
                      Content="Mit Remote-Tresor verbinden"
                      IsEnabled="{Binding CanConnectRemoteVault}"
                      ToolTip.Tip="{Binding RemoteVaultConnectionHint}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
